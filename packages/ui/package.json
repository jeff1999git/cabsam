{
  "name": "@excelcabs/ui",
  "version": "0.0.0",
  "private": true,
  "sideEffects": ["**/*.css"],
  "exports": {
    "./globals.css": "./src/styles/globals.css",
    "./components/*": "./src/components/*.tsx",
    "./composites/*": "./src/composites/*.tsx",
    "./hooks/*": "./src/hooks/*.ts",
    "./lib/*": "./src/lib/*.ts"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "class-variance-authority": "catalog:",
