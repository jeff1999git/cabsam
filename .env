# Excel Cabs — web app environment
# Copy to apps/web/.env.local and adjust. All values are optional; defaults are shown.

# Display name used in page titles.
NEXT_PUBLIC_APP_NAME="Excel Cabs"

# Simulated network latency (ms) for mock services, so loading states are visible.
NEXT_PUBLIC_MOCK_LATENCY_MS=400

# Show the subtle "demo account" helper on sign-in pages.
NEXT_PUBLIC_SHOW_DEMO_CREDENTIALS=true

# Reserved for the future real API implementation of the services in apps/web/src/services.
# Not used by the mock services.
# NEXT_PUBLIC_API_BASE_URL=https://api.excelcabs.example/v1
