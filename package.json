{
  "name": "excelcabs",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "pnpm --filter web start",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test:e2e": "turbo run test:e2e",
    "check": "turbo run lint typecheck --concurrency=2 && turbo run build"
  },
  "devDependencies": {
    "turbo": "catalog:",
    "typescript": "catalog:"
  }
}
